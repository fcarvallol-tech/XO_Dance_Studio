# Copiar a .env.local y rellenar. .env.local NUNCA se commitea.

# Supabase — panel del proyecto > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Service role key. Solo se usa en el servidor (app/api/lead/route.ts).
# Nunca prefijarla con NEXT_PUBLIC_ ni importarla desde un componente cliente.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp de contacto, solo dígitos con código de país.
NEXT_PUBLIC_WHATSAPP=56984362290

# URL pública del sitio. Se usa para metadata y Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
