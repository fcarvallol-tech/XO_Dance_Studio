# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — nunca commitear credenciales.
# .env.example sí se commitea: documenta qué variables hacen falta.
.env*
!.env.example

# vercel
.vercel

# assets crudos — pesados, no van al repo.
# En public/ solo viven las versiones comprimidas.
Assets/Videos/originales/

# Fotos originales: personas reales en alta resolución, y el repo es público.
# Lo publicado es la versión recortada de public/ (scripts/fotos-profesoras.mjs).
# El .gitkeep ya estaba versionado y sigue: la carpeta existe en los dos lados.
Assets/Fotos/

# typescript
*.tsbuildinfo
next-env.d.ts
